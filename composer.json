{
    "name": "domdanao/finfactory-qrph",
    "description": "Draw QR Ph codes as SVG, with the QR Ph logo in the centre. Any QR Ph payload: from FinFactory Payments or any other provider.",
    "type": "library",
    "keywords": ["qrph", "qr code", "svg", "philippines", "payments", "finfactory"],
    "license": "MIT",
    "homepage": "https://github.com/domdanao/finfactory-payments/tree/main/qrph-php",
    "support": {
        "issues": "https://github.com/domdanao/finfactory-payments/issues",
        "source": "https://github.com/domdanao/finfactory-qrph-php"
    },
    "require": {
        "php": ">=8.1",
        "chillerlan/php-qrcode": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": { "FinFactory\\QrPh\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "FinFactory\\QrPh\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
